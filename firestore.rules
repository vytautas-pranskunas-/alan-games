rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vytasbboy@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /dailyBattles/{date} {
      allow read, write: if true;
    }

    match /ballots/{ballotId} {
      allow read, write: if true;
    }

    match /ideas/{ideaId} {
      // Public can only read approved ideas; moderator can read everything.
      allow read: if resource.data.status == 'published' || isAdmin();

      allow create: if request.resource.data.keys().hasAll([
          'nickname', 'title', 'body', 'status', 'date'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.nickname is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.title.size() > 0
        && request.resource.data.body.size() > 0
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.title.size() <= 80
        && request.resource.data.body.size() <= 2000;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
